{
  "name": "tool-forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "tools:gen": "node scripts/generate-registry.mjs",
    "predev": "pnpm tools:gen",
    "prebuild": "pnpm tools:gen",
    "pretest": "pnpm tools:gen",
    "pretypecheck": "pnpm tools:gen",
    "dev": "pnpm --filter @tool-forge/web dev",
    "build": "pnpm --filter @tool-forge/web build",
    "preview": "pnpm --filter @tool-forge/web preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && pnpm --recursive --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @tool-forge/web e2e",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "validate:full": "pnpm validate && pnpm build && pnpm e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.20.1",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
